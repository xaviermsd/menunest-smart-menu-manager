<?xml version="1.0"?>
<ruleset name="MenuNest">
	<description>WordPress Coding Standards and PHP compatibility for MenuNest.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/.github/*</exclude-pattern>
	<exclude-pattern>/tests/wp-tests-config.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="menunest-smart-menu-manager"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="menunest"/>
			</property>
		</properties>
	</rule>
	<!-- Test files follow PHPUnit naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneObjectStructurePerFile">
		<exclude-pattern>/tests/class-menunest-testcase.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/phpstan-bootstrap.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/test-*.php</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/test-*.php</exclude-pattern>
	</rule>
</ruleset>
